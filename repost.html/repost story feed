<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Repost Instagram</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            display: flex;
            justify-content: center;
            padding-top: 40px;
        }
        .card {
            width: 380px;
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 3px 12px rgba(0,0,0,0.15);
        }
        .header {
            display: flex;
            align-items: center;
            padding: 15px;
        }
        .profile {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: linear-gradient(45deg, #feda75, #d62976, #4f5bd5);
            margin-right: 10px;
        }
        .username {
            font-weight: bold;
        }
        .photo {
            height: 350px;
            background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045);
            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
            font-size: 28px;
            font-weight: bold;
        }
        .actions {
            padding: 15px;
        }
        .actions button {
            border: none;
            background: none;
            font-size: 28px;
            cursor: pointer;
            margin-right: 15px;
        }
        .repost-btn {
            width: 100%;
            background: #0095f6 !important;
            color: white;
            padding: 12px;
            border-radius: 8px;
            font-size: 16px !important;
            margin-top: 10px;
        }
        .caption {
            padding: 0 15px 15px;
        }
        .modal {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.5);
            justify-content: center;
            align-items: center;
        }
        .menu {
            background: white;
            width: 300px;
            border-radius: 15px;
            padding: 20px;
            text-align: center;
        }
        .menu h3 {
            margin-bottom: 20px;
        }
        .menu button {
            width: 100%;
            padding: 12px;
            margin: 5px 0;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 15px;
        }
        .feed {
            background: #0095f6;
            color: white;
        }
        .story {
            background: #833ab4;
            color: white;
        }
        .cancel {
            background: #ddd;
        }
        #status {
            text-align: center;
            color: #0095f6;
            font-weight: bold;
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <div class="card">
        <div class="header">
            <div class="profile"></div>
            <div>
                <div class="username">@user_instagram</div>
                <small>Medan, Indonesia</small>
            </div>
        </div>
        <div class="photo">
            INSTAGRAM POST
        </div>
        <div class="actions">
            <button>❤️</button>
            <button>💬</button>
            <button>📤</button>
            <button class="repost-btn" onclick="bukaRepost()">
                🔄 Repost
            </button>
            <div id="status"></div>
        </div>
        <div class="caption">
            <b>1.245 likes</b>
            <br><br>
            <b>@user_instagram</b> Ini contoh postingan Instagram.
        </div>
    </div>
    <!-- POP UP REPOST -->
    <div class="modal" id="modal">
        <div class="menu">
            <h3>Bagikan sebagai</h3>
            <button class="feed" onclick="repostFeed()">
                🔄 Repost ke Feed
            </button>
            <button class="story" onclick="repostStory()">
                📱 Repost ke Story
            </button>
            <button class="cancel" onclick="tutupRepost()">
                Batal
            </button>
        </div>
    </div>
    <script>
        function bukaRepost() {
            document.getElementById("modal").style.display = "flex";
        }
        function tutupRepost() {
            document.getElementById("modal").style.display = "none";
        }
        function repostFeed() {
            document.getElementById("status").innerHTML =
                "✅ Berhasil direpost ke Feed!";
            
            tutupRepost();
        }
        function repostStory() {
            document.getElementById("status").innerHTML =
                "✅ Berhasil dibagikan ke Story!";
            
            tutupRepost();
        }
    </script>
</body>
</html>